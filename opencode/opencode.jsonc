{
  "$schema": "https://opencode.ai/config.json",
  "model": "verboo-code/deepseek-v4-flash",
  "small_model": "verboo-code/qwen3.6-27b",
  "provider": {
    "verboo-code": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Verboo Code",
      "options": {
        "baseURL": "https://code.verboo.ai/router/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek v4 Flash",
          "limit": { "context": 1048576, "output": 8192 }
        },
        "qwen3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": { "context": 262144, "output": 8192 }
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "limit": { "context": 202752, "output": 8192 }
        },
        "gemma-4-31b-it": {
          "name": "Gemma 4 31B IT",
          "limit": { "context": 262144, "output": 8192 }
        },
        "@preset/glm4-7-flash": {
          "name": "GLM 4.7 Flash (preset)",
          "limit": { "context": 202000, "output": 8192 }
        }
      }
    }
  }
}
